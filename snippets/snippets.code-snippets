{
  "React Native Component": {
    "prefix": "rn",
    "body": [
      "import { View } from 'react-native';",
      "",
      "export function ${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}() {",
      "  return (",
      "    <View></View>",
      "  );",
      "}",
    ],
    "description": "Create the structure of a React Native Component.",
  },
  "React Native StyleSheet Component": {
    "prefix": "rn-s",
    "body": [
      "import { View, StyleSheet } from 'react-native';",
      "",
      "export function ${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}() {",
      "  return (",
      "    <View style={styles.container}>",
      "",
      "    </View>",
      "  );",
      "}",
      "",
      "const styles = StyleSheet.create({",
      "  container: {},",
      "});",
    ],
    "description": "Component with inline StyleSheet.",
  },
  "React Native Import StyleSheet Component": {
    "prefix": "rn-si",
    "body": [
      "import { View } from 'react-native';",
      "",
      "import { styles } from './styles';",
      "",
      "export function ${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}() {",
      "  return (",
      "    <View style={styles.container}>",
      "",
      "    </View>",
      "  );",
      "}",
    ],
    "description": "Component importing styles from ./styles.",
  },
  "React Native Styled Component": {
    "prefix": "rn-sc",
    "body": [
      "import { Container } from './styles';",
      "",
      "export function ${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}() {",
      "  return (",
      "    <Container>",
      "",
      "    </Container>",
      "  );",
      "}",
    ],
    "description": "Component using Styled Components.",
  },
  "React Native StyleSheet File": {
    "prefix": "rn-style",
    "body": [
      "import { StyleSheet } from 'react-native';",
      "",
      "export const styles = StyleSheet.create({",
      "  container: {}",
      "});",
    ],
    "description": "StyleSheet file for a React Native component.",
  },
  "React Native Styled Components File": {
    "prefix": "rn-styled",
    "body": [
      "import styled from 'styled-components/native';",
      "",
      "export const Container = styled.View`",
      "  flex: 1;",
      "`;",
    ],
    "description": "Styled Components file for a React Native component.",
  },
  "Hook useState": {
    "prefix": "ust",
    "body": ["const [${1:state}, ${2:setState}] = useState(${3});"],
    "description": "React useState hook.",
  },
  "Hook useEffect": {
    "prefix": "uef",
    "body": ["useEffect(() => {", "  ${1}", "}, [${2}]);"],
    "description": "React useEffect hook.",
  },
  "Object Destructuring": {
    "prefix": "od",
    "body": "const { ${1:propertyName} } = ${2:objectToDestruct};",
    "description": "Object destructuring assignment.",
  },
  "Basic Method": {
    "prefix": "fn",
    "body": ["function ${1:methodName}(${2:params}) {", "  ${0}", "}", ""],
    "description": "Create a method structure.",
  },
  "Basic Method Async": {
    "prefix": "fn-async",
    "body": [
      "async function ${1:methodName}(${2:params}) {",
      "  ${0}",
      "}",
      "",
    ],
    "description": "Create an async function structure.",
  },
  "Console Log": {
    "prefix": "cl",
    "body": "console.log(${1:object});",
    "description": "Log to the console.",
  },
  "React Native Component with Props": {
    "prefix": "rn-props",
    "body": [
      "import { View } from 'react-native';",
      "",
      "type Props = {",
      "  ${1:title}: ${2:string};",
      "};",
      "",
      "export function ${TM_DIRECTORY/.*[\\\\\\/](.*)$/$1/}({ ${1:title} }: Props) {",
      "  return (",
      "    <View>",
      "      ${0}",
      "    </View>",
      "  );",
      "}"
    ],
    "description": "React Native Component with typed Props (TypeScript)."
  },
  "React Native FlatList": {
    "prefix": "rn-fl",
    "body": [
      "<FlatList",
      "  data={${1:data}}",
      "  keyExtractor={(item) => String(item.${2:id})}",
      "  renderItem={({ item }) => (",
      "    ${0}",
      "  )}",
      "/>"
    ],
    "description": "FlatList with data, keyExtractor and renderItem."
  },
  "React Context": {
    "prefix": "rn-ctx",
    "body": [
      "import { createContext, useContext, useState, type ReactNode } from 'react';",
      "",
      "type ${1:Name}ContextData = {",
      "  ${2:value}: ${3:string};",
      "  set${2/(.*)/${1:/capitalize}/}: (value: ${3:string}) => void;",
      "};",
      "",
      "const ${1:Name}Context = createContext({} as ${1:Name}ContextData);",
      "",
      "export function ${1:Name}Provider({ children }: { children: ReactNode }) {",
      "  const [${2:value}, set${2/(.*)/${1:/capitalize}/}] = useState<${3:string}>(${4:''});",
      "",
      "  return (",
      "    <${1:Name}Context.Provider value={{ ${2:value}, set${2/(.*)/${1:/capitalize}/} }}>",
      "      {children}",
      "    </${1:Name}Context.Provider>",
      "  );",
      "}",
      "",
      "export function use${1:Name}() {",
      "  return useContext(${1:Name}Context);",
      "}"
    ],
    "description": "Context with Provider and custom hook (TypeScript)."
  },
}
