{
  "name": "rn-shortcut",
  "displayName": "React Native Snippets – TypeScript & Expo",
  "description": "Snippets for React Native and Expo: components, StyleSheet, styled-components, hooks, FlatList and Context. JS/TS.",
  "publisher": "fabianocs",
  "author": {
    "name": "Fabiano C. Souza"
  },
  "icon": "assets/icon.png",
  "license": "MIT",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabianocsouza/rn-shortcut.git"
  },
  "keywords": [
    "react native",
    "react-native",
    "react native snippets",
    "expo",
    "snippets",
    "typescript",
    "tsx",
    "javascript",
    "react",
    "hooks",
    "flatlist",
    "stylesheet",
    "styled-components",
    "context",
    "components",
    "shortcut"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Snippets",
    "AI"
  ],
  "main": "./extension.js",
  "bin": {
    "rn-snippets-mcp": "mcp/server.js"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:rnSnippets.addAiRules"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/snippets.code-snippets"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/snippets.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/snippets.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/snippets.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "rnSnippets.addAiRules",
        "title": "Add AI rules to project",
        "category": "React Native Snippets"
      },
      {
        "command": "rnSnippets.getStarted",
        "title": "Get Started",
        "category": "React Native Snippets"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "rnSnippets.mcp",
        "label": "React Native Snippets"
      }
    ],
    "walkthroughs": [
      {
        "id": "rnSnippets.gettingStarted",
        "title": "React Native Snippets",
        "description": "Snippets for React Native and Expo, and AI assistants that follow the same templates.",
        "steps": [
          {
            "id": "snippets",
            "title": "Type a prefix, press Tab",
            "description": "Type rn, rn-props, rn-fl or rn-ctx in a .tsx file and press Tab.\n[Open a new TSX file](command:workbench.action.files.newUntitledFile?%7B%22languageId%22%3A%22typescriptreact%22%7D)",
            "media": {
              "markdown": "media/walkthrough/snippets.md"
            },
            "completionEvents": [
              "onLanguage:typescriptreact"
            ]
          },
          {
            "id": "aiRules",
            "title": "Make AI follow the same templates",
            "description": "Write instruction files for Copilot, Cursor and Claude Code into this project.\n[Add AI rules](command:rnSnippets.addAiRules)",
            "media": {
              "markdown": "media/walkthrough/ai-rules.md"
            },
            "completionEvents": [
              "onCommand:rnSnippets.addAiRules"
            ]
          },
          {
            "id": "copilot",
            "title": "Let Copilot fetch the templates",
            "description": "The React Native Snippets MCP server is added to Copilot automatically. Use Agent mode and ask for React Native code.\n[Open Chat](command:workbench.action.chat.open)",
            "media": {
              "markdown": "media/walkthrough/copilot.md"
            }
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:ai-rules": "node scripts/build-ai-rules.js",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "npx --yes ovsx publish"
  },
  "galleryBanner": {
    "color": "#20232A",
    "theme": "dark"
  },
  "homepage": "https://github.com/fabianocsouza/rn-shortcut#readme",
  "bugs": {
    "url": "https://github.com/fabianocsouza/rn-shortcut/issues"
  }
}
